@page "/Activities"

<PageTitle>Activities</PageTitle>

<div class="activities-page">

    <h1>Activities & Tour Guides</h1>

    <section class="activities-intro">

        <p>
            Do you want to have the vacation of a lifetime but don't know
            how to plan or organize your trip?<br>

            Don't worry!<br />
            Check out some of the latest activities available in our

            <a href="/Calendar" class="calendar-link">
                Calendar
            </a>

            and join us for unforgettable experiences.
        </p>

    </section>

    <h2>Meet Our Tour Guides</h2>

    <div class="guide-container">

        <div class="guide-card">
            <img src="images/Sarah Johnson.jpg" alt="Guide 1">

            <h3>Sarah Johnson</h3>

            <p>
                Cultural tourism specialist with over 8 years of experience
                helping visitors discover local history and traditions.
            </p>
        </div>

        <div class="guide-card">
            <img src="images/Michael Torres.jpg" alt="Guide 2">

            <h3>Michael Torres</h3>

            <p>
                Adventure guide focused on outdoor experiences,
                hiking trails, and nature exploration.
            </p>
        </div>

        <div class="guide-card">
            <img src="images/Emma Wilson.jpg" alt="Guide 3">

            <h3>Emma Wilson</h3>

            <p>
                Expert in food tourism and local culture,
                creating memorable experiences for travelers.
            </p>
        </div>

    </div>

    <h2>Featured Activities</h2>

    <div class="activity-container">

        <div class="activity-card">
            <h3>🏛 Historic City Tour</h3>
            <p>Visit iconic landmarks and learn fascinating stories.</p>
        </div>

        <div class="activity-card">
            <h3>🏔 Mountain Adventure</h3>
            <p>Explore breathtaking landscapes and hiking trails.</p>
        </div>

        <div class="activity-card">
            <h3>🍽 Culinary Experience</h3>
            <p>Discover authentic local cuisine and hidden gems.</p>
        </div>

    </div>

    <h2>Why Travel With Us?</h2>

    <div class="benefits">

        <div>✔ Experienced Guides</div>

        <div>✔ Safe Activities</div>

        <div>✔ Local Experts</div>

        <div>✔ Easy Planning</div>

    </div>

    <h2>Join Us This Month</h2>
    <p class="monthly-subtitle">
        Discover some of our upcoming guided trips and reserve your spot today.
    </p>

    <div class="monthly-trips">
        <div class="trip-card">
            <img src="images/paris.jpg" alt="Paris">
            <div class="trip-info">
                <h3>Paris</h3>
                <p><strong>Departure:</strong> June 20, 2026</p>
                <p><strong>Duration:</strong> 7 Days</p>
                <a href="/destinations/3" class="trip-button">
                    Learn More
                </a>
            </div>
        </div>

        <div class="trip-card">
            <img src="images/tokyo.jpg" alt="Tokyo">
            <div class="trip-info">
                <h3>Tokyo</h3>
                <p><strong>Departure:</strong> June 20, 2026</p>
                <p><strong>Duration:</strong> 10 Days</p>
                <a href="/destinations/6" class="trip-button">
                    Learn More
                </a>
            </div>
        </div>

        <div class="trip-card">
            <img src="images/bali.jpg" alt="Bali">
            <div class="trip-info">
                <h3>Bali</h3>
                <p><strong>Departure:</strong> June 28, 2026</p>
                <p><strong>Duration:</strong> 5 Days</p>
                <a href="/destinations/1" class="trip-button">
                    Learn More
                </a>
            </div>
        </div>
    </div>

    <!-- SECCIÓN: ACTIVIDADES POR DESTINO -->
    <div class="activities-contact-section">

        <h2>Want to Know What Activities Are Available?</h2>
        <p class="activities-contact-subtitle">
            Contact us and we'll be happy to share the full agenda with all the activities available at your
            destination.
        </p>

        <div class="activities-contact-box">

            <div class="activities-contact-buttons">
                <a href="tel:+521234567890" class="activities-btn activities-btn-solid">
                    📞 Call us at (123) 456-7890
                </a>
                <a href="mailto:test@test.com" class="activities-btn activities-btn-outline">
                    ✉ Send us an email
                </a>
            </div>

            <p class="activities-contact-note">
                We respond within 24 hours · Monday to Friday 9am – 6pm
            </p>

        </div>

    </div>

   
</div>