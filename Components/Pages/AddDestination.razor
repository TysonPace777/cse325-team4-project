@page "/destinations/new"
@rendermode InteractiveServer
@using cse325_team4_project.Models
@using cse325_team4_project.Services
@using Microsoft.AspNetCore.Hosting
@inject DestinationService DestinationService
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Env

<PageTitle>Add Destination</PageTitle>

<div class="add-destination-page">
    <h1>Add New Destination</h1>

    <EditForm EditContext="editContext" OnSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-grid">
            <div class="form-field">
                <label for="name">Name</label>
                <InputText id="name" class="input-field" @bind-Value="newDestination.Name" />
                <ValidationMessage For="@(() => newDestination.Name)" />
            </div>

            <div class="form-field form-full-width">
                <label for="activities">Activities</label>
                <InputText id="activities" class="input-field" @bind-Value="newDestination.Activities" />
                <ValidationMessage For="@(() => newDestination.Activities)" />
            </div>

            <div class="form-field">
                <label for="price">Price</label>
                <InputNumber id="price" class="input-field" @bind-Value="newDestination.Price" />
                <ValidationMessage For="@(() => newDestination.Price)" />
            </div>

            <div class="form-field form-full-width">
                <label for="description">Description</label>
                <InputTextArea id="description" class="input-field" @bind-Value="newDestination.Description" rows="5" />
                <ValidationMessage For="@(() => newDestination.Description)" />
            </div>

            <div class="form-field form-full-width">
                <label for="image">Destination Image</label>
                <InputFile id="image" OnChange="OnInputFileChange" accept="image/*" />
                @if (!string.IsNullOrWhiteSpace(selectedFileName))
                {
                    <div class="selected-files">
                        <strong>Selected image</strong>
                        <div>@selectedFileName</div>
                    </div>
                }
            </div>

            <div class="form-actions form-full-width">
                <button class="btn-primary" type="submit">Save Destination</button>
                <button class="btn-secondary" type="button" @onclick="Cancel">Cancel</button>
            </div>

            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="form-status">@statusMessage</div>
            }
        </div>
    </EditForm>
</div>

@code {
    private readonly Destination newDestination = new()
    {
        Name = string.Empty,
        Description = string.Empty,
        ImageUrl = string.Empty,
        Activities = string.Empty,
        Price = 0m
    };

    private EditContext? editContext;
    private ValidationMessageStore? validationMessageStore;
    private IBrowserFile? selectedFile;
    private string selectedFileName = string.Empty;
    private string statusMessage = string.Empty;

    protected override void OnInitialized()
    {
        editContext = new EditContext(newDestination);
        validationMessageStore = new ValidationMessageStore(editContext);
    }

    private Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        selectedFileName = e.File.Name;
        statusMessage = string.Empty;

        if (editContext != null && validationMessageStore != null)
        {
            validationMessageStore.Clear(new FieldIdentifier(newDestination, nameof(newDestination.ImageUrl)));
            editContext.NotifyValidationStateChanged();
        }

        return Task.CompletedTask;
    }

    private async Task HandleSubmit()
    {
        if (editContext == null || validationMessageStore == null)
        {
            return;
        }

        validationMessageStore.Clear();

        if (!editContext.Validate())
        {
            return;
        }

        if (selectedFile == null)
        {
            validationMessageStore.Add(
                new FieldIdentifier(newDestination, nameof(newDestination.ImageUrl)),
                "Please upload an image for the destination card.");
            editContext.NotifyValidationStateChanged();
            return;
        }

        var uploadFolder = Path.Combine(Env.WebRootPath, "images", "uploads");
        Directory.CreateDirectory(uploadFolder);

        var safeName = Path.GetFileNameWithoutExtension(selectedFile.Name);
        var extension = Path.GetExtension(selectedFile.Name);
        var uniqueFileName = $"{safeName}-{Guid.NewGuid()}{extension}";
        var filePath = Path.Combine(uploadFolder, uniqueFileName);

        await using (var fileStream = File.Create(filePath))
        {
            await selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(fileStream);
        }

        newDestination.ImageUrl = $"/images/uploads/{uniqueFileName}";

        await DestinationService.AddDestinationAsync(newDestination);
        NavigationManager.NavigateTo("/destinations");
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/destinations");
    }
}

<style>
    .add-destination-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem;
    }

    .add-destination-page h1 {
        margin-bottom: 1.5rem;
    }

    .form-grid {
        display: grid;
        gap: 1.25rem;
    }

    .form-field {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .input-field {
        padding: 0.85rem 1rem;
        font-size: 1rem;
        border: 1px solid #d7dce8;
        border-radius: 10px;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .btn-primary,
    .btn-secondary {
        border: none;
        padding: 0.95rem 1.6rem;
        border-radius: 999px;
        cursor: pointer;
        font-size: 1rem;
        font-weight: 700;
    }

    .btn-primary {
        background: linear-gradient(135deg, #2f6bff, #7b5cff);
        color: white;
    }

    .btn-secondary {
        background: #eef2ff;
        color: #1e293b;
    }

    .selected-files {
        color: #546075;
    }

    .form-status {
        color: #b42318;
        font-weight: 600;
    }
</style>
