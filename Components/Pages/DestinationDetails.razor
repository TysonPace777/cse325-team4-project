@page "/destinations/{destinationId:int}"
@using cse325_team4_project.Models
@using cse325_team4_project.Services
@inject DestinationService DestinationService

<PageTitle>Destination Details</PageTitle>

@if (isLoading)
{
    <div class="details-loading">
        <p>Loading destination details...</p>
    </div>
}
else if (destination == null)
{
    <div class="details-not-found">
        <h2>Destination not found</h2>
        <p>We could not find the destination you are looking for.</p>
        <a class="btn-explore" href="/destinations">Back to destinations</a>
    </div>
}
else
{
    <div class="details-page">
        <div class="details-hero">
            <a class="btn-back" href="/destinations">&larr; Back to destinations</a>

            <div class="details-title">
                <p class="details-category">@destination.Category &middot; @destination.Country</p>
                <h1>@destination.Name</h1>
            </div>
        </div>


        <div class="details-content">
            <div class="details-image">
                @if (destination.ImageUrls == null || !destination.ImageUrls.Any())
                {
                    <div class="placeholder-image">No Image</div>
                }
                else
                {
                    <div class="main-image">
                        <img src="@activeImageUrl" alt="@destination.Name" />
                    </div>
                    <div class="thumbnail-row">
                        @foreach (var imageUrl in destination.ImageUrls)
                        {
                            <img class="thumbnail @(imageUrl == activeImageUrl ? "active" : "")" src="@imageUrl"
                                 alt="@destination.Name" @onclick="() => SelectImage(imageUrl)" />
                        }
                    </div>
                }
            </div>

            <div class="details-info">
                <h2>About this destination</h2>
                <p class="details-description">@destination.Description</p>

                <div class="details-metadata">
                    <div>
                        <strong>Rating</strong>
                        <div>⭐@destination.Rating.ToString("F1") / 5</div>
                    </div>
                    <div>
                        <strong>Best Time to Visit</strong>
                        <div>@destination.BestTimeToVisit</div>
                    </div>
                    <div>
                        <strong>Category</strong>
                        <div>@destination.Category</div>
                    </div>
                </div>

                <a class="btn-explore" href="/destinations">Browse more destinations</a>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int destinationId { get; set; }

    private Destination? destination;
    private string activeImageUrl = string.Empty;
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        destination = await DestinationService.GetDestinationByIdAsync(destinationId);

        if (destination?.ImageUrls != null && destination.ImageUrls.Any())
        {
            activeImageUrl = destination.ImageUrls[0];
        }

        isLoading = false;
    }

    private void SelectImage(string imageUrl)
    {
        activeImageUrl = imageUrl;
    }
}

