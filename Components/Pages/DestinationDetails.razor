@page "/destinations/{destinationId:int}"
@using cse325_team4_project.Models
@using cse325_team4_project.Services
@inject DestinationService DestinationService

<PageTitle>Destination Details</PageTitle>

@if (isLoading)
{
    <div class="details-loading">
        <p>Loading destination details...</p>
    </div>
}
else if (destination == null)
{
    <div class="details-not-found">
        <h2>Destination not found</h2>
        <p>We could not find the destination you are looking for.</p>
        <a class="btn-back" href="/destinations">Back to destinations</a>
    </div>
}
else
{
    <div class="details-page">
        <div class="details-header">
            <a class="btn-back" href="/destinations">← Back</a>
            <div>
                <p class="eyebrow">Destination</p>
                <h1>@destination.Name</h1>
            </div>
        </div>

        <div class="details-content">
            <div class="details-image">
                <img src="@destination.ImageUrl" alt="@destination.Name" />
            </div>

            <div class="details-info">
                <div class="details-card">
                    <span class="label">Activities</span>
                    <p>@destination.Activities</p>
                </div>

                <div class="details-card">
                    <span class="label">Price</span>
                    <p class="price">@destination.Price.ToString("C")</p>
                </div>

                <div class="details-card">
                    <span class="label">Description</span>
                    <p>@destination.Description</p>
                </div>

                <a class="btn-explore" href="/destinations">Browse more destinations</a>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int destinationId { get; set; }

    private Destination? destination;
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        destination = await DestinationService.GetDestinationByIdAsync(destinationId);
        isLoading = false;
    }
}

<style>
    .details-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem;
    }

    .details-header {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }

    .eyebrow {
        margin: 0 0 0.35rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.8rem;
        color: #7b5cff;
        font-weight: 700;
    }

    .details-header h1 {
        margin: 0;
        font-size: clamp(2rem, 4vw, 3.25rem);
    }

    .btn-back,
    .btn-explore {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 0.8rem 1.15rem;
        text-decoration: none;
        font-weight: 700;
    }

    .btn-back {
        border: 1px solid #d7dce8;
        color: #101828;
        background: white;
    }

    .details-content {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 1.5rem;
    }

    .details-image img {
        width: 100%;
        border-radius: 28px;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        box-shadow: 0 18px 45px rgba(28, 39, 64, 0.12);
    }

    .details-info {
        display: grid;
        gap: 1rem;
    }

    .details-card {
        padding: 1.15rem;
        border-radius: 20px;
        background: white;
        border: 1px solid rgba(114, 126, 160, 0.15);
        box-shadow: 0 12px 35px rgba(28, 39, 64, 0.08);
    }

    .label {
        display: block;
        margin-bottom: 0.5rem;
        color: #7b5cff;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .price {
        font-size: 1.6rem;
        font-weight: 800;
    }

    .btn-explore {
        color: white;
        background: #101828;
    }

    .details-loading,
    .details-not-found {
        max-width: 900px;
        margin: 0 auto;
        padding: 3rem 2rem;
    }

    @@media (max-width: 900px) {
        .details-content {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 720px) {
        .details-page {
            padding: 1rem;
        }

        .btn-back,
        .btn-explore {
            width: 100%;
        }
    }
</style>
