@page "/destinations"
@page "/destinations/category/{category}"
@using cse325_team4_project.Models
@using cse325_team4_project.Services
@inject DestinationService DestinationService
@inject NavigationManager NavigationManager

<PageTitle>Destination Ideas</PageTitle>

<div class="destinations-container">
    <div class="destinations-header">
        <div>
            <h1>Explore Destination Ideas</h1>
            <p class="subtitle">Discover amazing places around the world based on images and categories</p>
        </div>
        <button class="btn-add" @onclick="CreateDestination">Add Destination</button>
    </div>

    <div class="filters-section">
        <div class="search-box">
            <input type="text" placeholder="Search destinations..." @oninput="OnSearchInput" />
        </div>

        <div class="category-filters">
            <a class="filter-btn @(selectedCategory == null ? "active" : "")" href="/destinations">
                All
            </a>

            @foreach (var category in categories)
            {
                <a class="filter-btn @(selectedCategory?.Equals(category, StringComparison.OrdinalIgnoreCase) == true ? "active" : "")"
                   href="@($"/destinations/category/{Uri.EscapeDataString(category)}")">
                    @category
                </a>
            }
        </div>
    </div>

    @if (filteredDestinations.Count == 0)
    {
        <div class="no-results">
            <p>No destinations found. Try a different search or category.</p>
        </div>
    }
    else
    {
        <div class="destinations-grid">
            @foreach (var destination in filteredDestinations)
            {
                <div class="destination-card">
                    <div class="destination-image">
                        <a class="destination-link" href="@($"/destinations/{destination.Id}")">
                            @if (string.IsNullOrEmpty(destination.PreviewImageUrl))
                            {
                                <div class="placeholder-image">No Image</div>
                            }
                            else
                            {
                                <img src="@destination.PreviewImageUrl" alt="@destination.Name" />
                            }
                        </a>
                        <div class="category-badge">@destination.Category</div>
                    </div>
                    <div class="destination-info">
                        <h3><a class="destination-title" href="@($"/destinations/{destination.Id}")">@destination.Name</a></h3>
                        <p class="country">@destination.Country</p>
                        <p class="description">@destination.Description</p>
                        <div class="destination-details">
                            <div class="detail">
                                <strong>Rating:</strong> ⭐ @destination.Rating.ToString("F1")
                            </div>
                            <div class="detail">
                                <strong>Best Time:</strong> @destination.BestTimeToVisit
                            </div>
                        </div>
                        <a class="btn-explore" href="@($"/destinations/{destination.Id}")">Learn More</a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Destination> allDestinations = new();
    private List<Destination> filteredDestinations = new();
    private List<string> categories = new();
    private string? selectedCategory;
    private string searchQuery = "";

    [Parameter]
    public string? category { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        allDestinations = (await DestinationService.GetAllDestinationsAsync()).ToList();
        categories = (await DestinationService.GetCategoriesAsync()).ToList();
        selectedCategory = categories.FirstOrDefault(c => string.Equals(c, category, StringComparison.OrdinalIgnoreCase));
        await ApplyFilters();
    }

    private void NavigateToCategory(string? selectedCategory)
    {
        if (string.IsNullOrWhiteSpace(selectedCategory))
        {
            NavigationManager.NavigateTo("/destinations");
        }
        else
        {
            NavigationManager.NavigateTo($"/destinations/category/{Uri.EscapeDataString(selectedCategory)}");
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        await ApplyFilters();
    }

    private async Task ApplyFilters()
    {
        var result = allDestinations.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var searchResults = await DestinationService.SearchDestinationsAsync(searchQuery);
            result = result.Intersect(searchResults);
        }

        if (selectedCategory != null)
        {
            result = result.Where(d => d.Category == selectedCategory);
        }

        filteredDestinations = result.ToList();
    }

    private void NavigateToDetails(int destinationId)
    {
        NavigationManager.NavigateTo($"/destinations/{destinationId}");
    }

    private void CreateDestination()
    {
        NavigationManager.NavigateTo("/destinations/new");
    }
}


