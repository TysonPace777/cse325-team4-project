@page "/destinations"
@page "/destinations/category/{category}"
@using cse325_team4_project.Models
@using cse325_team4_project.Services
@inject DestinationService DestinationService
@inject NavigationManager NavigationManager

<PageTitle>Destination Ideas</PageTitle>

<div class="destinations-container">
    <div class="destinations-header">
        <div>
            <h1>Explore Destination Ideas</h1>
            <p class="subtitle">Discover amazing places around the world based on images and categories</p>
        </div>
        <button class="btn-add" @onclick="CreateDestination">Add Destination</button>
    </div>

    <div class="filters-section">
        <div class="search-box">
            <input type="text" placeholder="Search destinations..." @oninput="OnSearchInput" />
        </div>

        <div class="category-filters">
            <button class="filter-btn @(selectedCategory == null ? "active" : "")" @onclick="@(() => NavigateToCategory(null))">
                All
            </button>
            @foreach (var category in categories)
            {
                <button class="filter-btn @(selectedCategory?.Equals(category, StringComparison.OrdinalIgnoreCase) == true ? "active" : "")" @onclick="@(() => NavigateToCategory(category))">
                    @category
                </button>
            }
        </div>
    </div>

    @if (filteredDestinations.Count == 0)
    {
        <div class="no-results">
            <p>No destinations found. Try a different search or category.</p>
        </div>
    }
    else
    {
        <div class="destinations-grid">
            @foreach (var destination in filteredDestinations)
            {
                <div class="destination-card">
                    <div class="destination-image">
                        <a class="destination-link" href="@($"/destinations/{destination.Id}")">
                            @if (string.IsNullOrEmpty(destination.PreviewImageUrl))
                            {
                                <div class="placeholder-image">No Image</div>
                            }
                            else
                            {
                                <img src="@destination.PreviewImageUrl" alt="@destination.Name" />
                            }
                        </a>
                        <div class="category-badge">@destination.Category</div>
                    </div>
                    <div class="destination-info">
                        <h3><a class="destination-title" href="@($"/destinations/{destination.Id}")">@destination.Name</a></h3>
                        <p class="country">@destination.Country</p>
                        <p class="description">@destination.Description</p>
                        <div class="destination-details">
                            <div class="detail">
                                <strong>Rating:</strong> ⭐ @destination.Rating.ToString("F1")
                            </div>
                            <div class="detail">
                                <strong>Best Time:</strong> @destination.BestTimeToVisit
                            </div>
                        </div>
                        <a class="btn-explore" href="@($"/destinations/{destination.Id}")">Learn More</a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Destination> allDestinations = new();
    private List<Destination> filteredDestinations = new();
    private List<string> categories = new();
    private string? selectedCategory;
    private string searchQuery = "";

    [Parameter]
    public string? category { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        allDestinations = (await DestinationService.GetAllDestinationsAsync()).ToList();
        categories = (await DestinationService.GetCategoriesAsync()).ToList();
        selectedCategory = categories.FirstOrDefault(c => string.Equals(c, category, StringComparison.OrdinalIgnoreCase));
        await ApplyFilters();
    }

    private void NavigateToCategory(string? selectedCategory)
    {
        if (string.IsNullOrWhiteSpace(selectedCategory))
        {
            NavigationManager.NavigateTo("/destinations");
        }
        else
        {
            NavigationManager.NavigateTo($"/destinations/category/{Uri.EscapeDataString(selectedCategory)}");
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        await ApplyFilters();
    }

    private async Task ApplyFilters()
    {
        var result = allDestinations.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var searchResults = await DestinationService.SearchDestinationsAsync(searchQuery);
            result = result.Intersect(searchResults);
        }

        if (selectedCategory != null)
        {
            result = result.Where(d => d.Category == selectedCategory);
        }

        filteredDestinations = result.ToList();
    }

    private void NavigateToDetails(int destinationId)
    {
        NavigationManager.NavigateTo($"/destinations/{destinationId}");
    }

    private void CreateDestination()
    {
        NavigationManager.NavigateTo("/destinations/new");
    }
}

<style>
    .destinations-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
    }

    .destinations-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }

    .btn-add {
        background: #28a745;
        color: white;
        border: none;
        border-radius: 12px;
        padding: 0.9rem 1.4rem;
        cursor: pointer;
        font-size: 1rem;
        font-weight: bold;
    }

    .btn-add:hover {
        background: #218838;
    }

    h1 {
        text-align: left;
        margin-bottom: 0.5rem;
        color: #333;
    }

    .subtitle {
        text-align: left;
        color: #666;
        margin-bottom: 2rem;
        font-size: 1.1rem;
    }

    .filters-section {
        margin-bottom: 2rem;
    }

    .search-box {
        margin-bottom: 1rem;
    }

    .search-box input {
        width: 100%;
        padding: 0.75rem;
        font-size: 1rem;
        border: 2px solid #ddd;
        border-radius: 8px;
        transition: border-color 0.3s;
    }

    .search-box input:focus {
        outline: none;
        border-color: #007bff;
    }

    .category-filters {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .filter-btn {
        padding: 0.5rem 1rem;
        border: 2px solid #ddd;
        background: white;
        border-radius: 20px;
        cursor: pointer;
        transition: all 0.3s;
        font-size: 0.95rem;
    }

    .filter-btn:hover {
        border-color: #007bff;
        color: #007bff;
    }

    .filter-btn.active {
        background: #007bff;
        color: white;
        border-color: #007bff;
    }

    .destinations-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }

    .destination-card {
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s, box-shadow 0.3s;
        background: white;
        display: flex;
        flex-direction: column;
    }

    .destination-link,
    .destination-title {
        color: inherit;
        text-decoration: none;
    }

    .destination-link:hover img,
    .destination-title:hover {
        opacity: 0.9;
    }

    .destination-title {
        font-size: inherit;
        font-weight: inherit;
    }

    .destination-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    }

    .destination-image {
        position: relative;
        width: 100%;
        height: 200px;
        background: #f0f0f0;
        overflow: hidden;
    }

    .destination-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .placeholder-image {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e0e0e0;
        color: #999;
        font-size: 1rem;
    }

    .category-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        background: #007bff;
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: bold;
    }

    .destination-info {
        padding: 1.5rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .destination-info h3 {
        margin: 0 0 0.25rem 0;
        color: #333;
        font-size: 1.25rem;
    }

    .country {
        color: #007bff;
        margin: 0 0 0.75rem 0;
        font-weight: 500;
    }

    .description {
        color: #666;
        margin: 0 0 1rem 0;
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .destination-details {
        margin-bottom: 1rem;
        flex-grow: 1;
    }

    .detail {
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
        color: #555;
    }

    .btn-explore {
        background: #007bff;
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 6px;
        cursor: pointer;
        font-size: 1rem;
        font-weight: bold;
        transition: background 0.3s;
        width: 100%;
    }

    .btn-explore:hover {
        background: #0056b3;
    }

    .no-results {
        text-align: center;
        padding: 3rem 1rem;
        color: #666;
        font-size: 1.1rem;
    }

    @@media (max-width: 768px) {
        .destinations-grid {
            grid-template-columns: 1fr;
        }

        .category-filters {
            gap: 0.25rem;
        }

        .filter-btn {
            padding: 0.4rem 0.8rem;
            font-size: 0.85rem;
        }
    }
</style>
