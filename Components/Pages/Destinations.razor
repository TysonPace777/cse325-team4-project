@page "/destinations"
@rendermode InteractiveServer
@using cse325_team4_project.Models
@using cse325_team4_project.Services
@inject DestinationService DestinationService
@inject NavigationManager NavigationManager

<PageTitle>Destinations</PageTitle>

<div class="destinations-shell">
    <div class="destinations-header">
        <div>
            <p class="eyebrow">Travel ideas</p>
            <h1>Explore destinations</h1>
            <p class="subtitle">Cards are loaded from the SQLite database and can be searched by name, activity, or description.</p>
        </div>
        <button class="btn-add" @onclick="CreateDestination">Add Destination</button>
    </div>

    <div class="search-box">
        <input type="text" placeholder="Search destinations..." @oninput="OnSearchInput" />
    </div>

    @if (filteredDestinations.Count == 0)
    {
        <div class="no-results">
            <p>No destinations found. Try a different search.</p>
        </div>
    }
    else
    {
        <div class="destinations-grid">
            @foreach (var destination in filteredDestinations)
            {
                <article class="destination-card">
                    <a class="destination-image-link" href="@($"/destinations/{destination.Id}")">
                        <img class="destination-image" src="@destination.ImageUrl" alt="@destination.Name" />
                    </a>
                    <div class="destination-info">
                        <h2><a class="destination-title" href="@($"/destinations/{destination.Id}")">@destination.Name</a></h2>
                        <p class="activities">@destination.Activities</p>
                        <div class="price-row">
                            <span class="price-label">From</span>
                            <span class="price-value">@destination.Price.ToString("C")</span>
                        </div>
                        <a class="btn-explore" href="@($"/destinations/{destination.Id}")">View Details</a>
                    </div>
                </article>
            }
        </div>
    }
</div>

@code {
    private List<Destination> allDestinations = new();
    private List<Destination> filteredDestinations = new();
    private string searchQuery = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        allDestinations = (await DestinationService.GetAllDestinationsAsync()).ToList();
        filteredDestinations = allDestinations;
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredDestinations = allDestinations;
            return;
        }

        filteredDestinations = (await DestinationService.SearchDestinationsAsync(searchQuery)).ToList();
    }

    private void CreateDestination()
    {
        NavigationManager.NavigateTo("/destinations/new");
    }
}

<style>
    .destinations-shell {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
    }

    .destinations-header {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: end;
        flex-wrap: wrap;
        margin-bottom: 1.25rem;
    }

    .eyebrow {
        margin: 0 0 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.8rem;
        color: #7b5cff;
        font-weight: 700;
    }

    h1 {
        margin: 0;
        font-size: clamp(2rem, 4vw, 3.5rem);
    }

    .subtitle {
        max-width: 58ch;
        margin: 0.75rem 0 0;
        color: #556070;
    }

    .btn-add {
        border: none;
        border-radius: 999px;
        padding: 0.95rem 1.4rem;
        font-weight: 700;
        cursor: pointer;
        color: white;
        background: linear-gradient(135deg, #2f6bff, #7b5cff);
        box-shadow: 0 12px 30px rgba(47, 107, 255, 0.24);
    }

    .search-box {
        margin-bottom: 1.5rem;
    }

    .search-box input {
        width: 100%;
        padding: 0.95rem 1rem;
        font-size: 1rem;
        border-radius: 14px;
        border: 1px solid #d7dce8;
        background: white;
    }

    .destinations-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.25rem;
    }

    .destination-card {
        overflow: hidden;
        border-radius: 24px;
        background: white;
        box-shadow: 0 18px 45px rgba(28, 39, 64, 0.12);
        border: 1px solid rgba(114, 126, 160, 0.15);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .destination-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 24px 60px rgba(28, 39, 64, 0.18);
    }

    .destination-image-link {
        display: block;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        background: linear-gradient(135deg, #eef2ff, #f8fafc);
    }

    .destination-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .destination-info {
        padding: 1.1rem 1.15rem 1.3rem;
        display: grid;
        gap: 0.85rem;
    }

    .destination-title {
        color: #101828;
        text-decoration: none;
        font-size: 1.25rem;
        margin: 0;
    }

    .activities {
        margin: 0;
        color: #546075;
        line-height: 1.55;
    }

    .price-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        padding-top: 0.25rem;
    }

    .price-label {
        color: #6b7280;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .price-value {
        color: #0f172a;
        font-size: 1.25rem;
        font-weight: 800;
    }

    .btn-explore {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        border-radius: 999px;
        padding: 0.85rem 1rem;
        background: #101828;
        color: white;
        text-decoration: none;
        font-weight: 700;
    }

    .no-results {
        padding: 2rem 0;
        color: #556070;
    }

    @@media (max-width: 720px) {
        .destinations-shell {
            padding: 1rem;
        }

        .destinations-header {
            align-items: start;
        }

        .btn-add,
        .btn-explore {
            width: 100%;
        }
    }
</style>
