@page "/"

@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Home</PageTitle>

<h1>Travel Planner</h1>

<AuthorizeView>
    <Authorized Context="auth">
        <p class="username">Hello, @auth.User.Identity?.Name</p>
    </Authorized>
</AuthorizeView>
