<div class="home-auth-corner">
    <AuthorizeView>
        <Authorized Context="auth">
            <form method="post" action="/Account/Login?handler=Logout">
                <button class="home-auth-button" type="submit">Logout</button>
            </form>
        </Authorized>
        <NotAuthorized Context="auth">
            <a class="home-auth-button" href="/Signin">Sign In</a>
        </NotAuthorized>
    </AuthorizeView>
</div>



<h3 class="home-title">Where do you want to go?</h3>


<ul class="home-card-list">
    <li>
        <a class="home-category-card" href="/destinations/category/Historic">
            <img src="images/kyoto.jpg" alt="Historic destinations" />
            <span>Historic Cities</span>
        </a>
    </li>

    <li>
        <a class="home-category-card" href="/destinations/category/Beach">
            <img src="images/tropical-beach-scene.webp" alt="Beach destinations" />
            <span>Beach</span>
        </a>
    </li>

    <li>
        <a class="home-category-card" href="/destinations/category/Mountain">
            <img src="images/most-beautiful-mountains-in-america-grand-teton.webp" alt="Mountain destinations" />
            <span>Mountain</span>
        </a>
    </li>
    <li>
        <a class="home-category-card" href="/destinations/category/City">
            <img src="images/paris.jpg" alt="City destinations" />
            <span>City</span>
        </a>
    </li>
</ul>



