@page "/Signin"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Mode { get; set; }

    private bool isLogin = false;
    private string frontendError = "";

    private string regEmail = "";
    private string regPassword = "";
    private string regConfirm = "";

    protected override void OnInitialized()
    {
        if (Mode == "login") isLogin = true;
    }

    private void ValidateRegister()
    {
        if (regPassword != regConfirm)
        {
            frontendError = "Passwords do not match.";
        }
        else
        {
            frontendError = string.Empty;
        }
    }
}

@{
    var token = Antiforgery.GetAndStoreTokens(HttpContextAccessor.HttpContext!).RequestToken;
}

@if (!string.IsNullOrEmpty(frontendError))
{
    <p style="color:red">@frontendError</p>
}
else if (!string.IsNullOrEmpty(Error))
{
    <p style="color:red">@Uri.UnescapeDataString(Error)</p>
}

@if (isLogin)
{
    <form method="post" action="/Account/Login?handler=Login" class="signin-form">
        <input type="hidden" name="__RequestVerificationToken" value="@token" />
        <input type="hidden" name="returnUrl" value="/" />
        <input type="email" name="email" placeholder="Email" required />
        <input type="password" name="password" placeholder="Password" required />
        <button type="submit">Login</button>
    </form>
    <button type="button" @onclick="() => { isLogin = false; frontendError = string.Empty; }">Need an account?</button>
}
else
{
    <form method="post" action="/Account/Login?handler=Register" class="signin-form">
        <input type="hidden" name="__RequestVerificationToken" value="@token" />
        <input type="hidden" name="returnUrl" value="/" />
        <input type="email" name="email" placeholder="Email" required />
        <input type="password" name="password" placeholder="Password" required minlength="6"
            @oninput="e => regPassword = e.Value?.ToString() ?? string.Empty" />
        <input type="password" name="confirmPassword" placeholder="Confirm Password" required
            @oninput="e => regConfirm = e.Value?.ToString() ?? string.Empty" />
        @if (!string.IsNullOrEmpty(frontendError))
        {
            <p style="color:red">@frontendError</p>
        }
        <button type="submit" @onclick="ValidateRegister">Register</button>
    </form>
    <button type="button" @onclick="() => { isLogin = true; frontendError = string.Empty; }">Already have an account?</button>
}